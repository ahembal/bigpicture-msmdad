            <Parent_Attribute>-</Parent_Attribute>
            <Description>A unique identifier of the Biological Being.</Description>
            <Explanation>The uniqueness refers to the context of the dataset. Defined by the data submitter.</Explanation>
            <METAFLEX>ObjectType Attribute “alias” AND/OR “accession”</METAFLEX>
            <Value_Specification>
                <NA>not allowed</NA>
                <NA_Value>not applicable</NA_Value>
                <Data_Type>STRING</Data_Type>
                <Unit>not applicable</Unit>
                <Comment>
                    CAVEAT:
                    During dataset creation the submitter must use the Object Attribute “alias” to state a
                    unique identifier, however, during the submission process that repository automatically
                    generates a unique accession ID for each submitted CMMS Entity. This accession ID will
                    be automatically injected into the XML file using the xs:attribute “accession” by the
                    repository during the upload process.
                    Once a accession ID has been generated all references to a given CMMS Entity must use
                    the xs:attribute “accession” and not the xs:attribute “alias”.
                </Comment>
            </Value_Specification>
