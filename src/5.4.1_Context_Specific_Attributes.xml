                </Attribute>
            </Entity>
            <Entity name="Case">
                <Attribute>
                    <Name>Case ID</Name>
                    <Attribute_ID>2.1.1</Attribute_ID>
                </Attribute>
            </Entity>
            <Entity name="Specimen">
                <Attribute>
                    <Name>Part of Case</Name>
